# ── 审稿: **必须换一个模型**。同一个模型审自己写的答案基本全过, 六维形同虚设。
# 122B 正好是池子里唯一和 27B 不同的那个, 用它来审。
review:
  - {name: "云-122B", url: "http://<换成你的域名>:31080/v1", model: "Qwen3.5-122B-A10B", key: "<填 sk>", concurrency: 2}

# ── 闸5 图像质检(可选, 不配就复用 generate)
screen: []
