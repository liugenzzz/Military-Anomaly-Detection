  - {name: "103-4", url: "http://10.200.100.103:8004/v1",  model: "Qwen3.8-27B", key: "local-pool-key", concurrency: 4}
  - {name: "7-1",   url: "http://10.107.238.7:8001/v1",    model: "Qwen3.8-27B", key: "local-pool-key", concurrency: 4}
  - {name: "7-2",   url: "http://10.107.238.7:8002/v1",    model: "Qwen3.8-27B", key: "local-pool-key", concurrency: 4}
  - {name: "7-3",   url: "http://10.107.238.7:8003/v1",    model: "Qwen3.8-27B", key: "local-pool-key", concurrency: 4}
  - {name: "7-4",   url: "http://10.107.238.7:8004/v1",    model: "Qwen3.8-27B", key: "local-pool-key", concurrency: 4}
